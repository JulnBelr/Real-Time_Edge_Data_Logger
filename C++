int Potential_meter = A0;

volatile uint16_t samplesReady = 0;

const uint8_t BUFFER_SIZE = 8;

struct Sample
{
    unsigned long timestamp;
    uint16_t raw;
    float voltage;
};

Sample buffer[BUFFER_SIZE];

uint8_t writeIndex = 0;
uint8_t readIndex = 0;

volatile uint8_t bufferCount = 0;

uint16_t droppedSamples = 0;

void setup()
{
    Serial.begin(115200);

    noInterrupts();

    // Clear Timer1 registers
    TCCR1A = 0;
    TCCR1B = 0;

    // Reset Timer1
    TCNT1 = 0;

    // 100 Hz with 16 MHz clock and 256 prescaler
    OCR1A = 624;

    // CTC mode
    TCCR1B |= (1 << WGM12);

    // Prescaler = 256
    TCCR1B |= (1 << CS12);

    // Enable Timer1 Compare Match A interrupt
    TIMSK1 |= (1 << OCIE1A);

    interrupts();
}

void loop()
{
    // =========================
    // PRODUCER
    // =========================

    noInterrupts();

    if (samplesReady > 0)
    {
        samplesReady--;

        interrupts();


        if (bufferCount < BUFFER_SIZE)
        {
            unsigned long currentTime = millis();

        int newReading = analogRead(Potential_meter);

            buffer[writeIndex].timestamp = currentTime;
            buffer[writeIndex].raw = newReading;
            buffer[writeIndex].voltage = newReading*(5.0/1023.0);


            writeIndex++;

            if (writeIndex >= BUFFER_SIZE)
            {
                writeIndex = 0;
            }

            bufferCount++;
        }
        else
        {
                droppedSamples++;

        }
    }
    else
    {
        interrupts();       
}
    

    // =========================
    // CONSUMER
    // =========================

    if (bufferCount > 0)
    {
        uint16_t  rawReading = buffer[readIndex].raw;

        unsigned long timeStamp = buffer[readIndex].timestamp;

        float voltage = buffer[readIndex].voltage;



        readIndex++;

        if (readIndex >= BUFFER_SIZE)
        {
            readIndex = 0;
        }

        bufferCount--;

        // CSV FORMAT
        Serial.print("# Dropped samples: ");
        Serial.println(droppedSamples);
        Serial.print(timeStamp);
        Serial.print(",");
        Serial.print(rawReading);
        Serial.print(",");
        Serial.println(voltage);

    }
}


ISR(TIMER1_COMPA_vect)
{
    samplesReady++;
}
